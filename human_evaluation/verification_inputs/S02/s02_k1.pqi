KNOBS
 -convergence_tolerance 1e-12
SOLUTION 1
    temp      200
    pH        2
    pe        4
    redox     pe
    units     mmol/kgw
    density   1
    Cu(2)     10
    Ba        5
    -water    1 # kg

KINETICS 1
Calcite
    -formula  CaCO3  1
    -m        1
    -m0       1
    -parms    1 10
-steps       1000 in 100 steps # seconds
SELECTED_OUTPUT 1
    -file s02_k1.sel
    -reset false
    -step true
    -high_precision true
USER_PUNCH 1
    -headings pH pe SI_With mCO2 Alk Calcite_m
    10 PUNCH -LA("H+"), -LA("e-"), SI("Witherite"), MOL("CO2"), ALK, KIN("Calcite")
END
